# ============================================================================
# GENERAL IGNORE PATTERNS
# ============================================================================

# Compressed files
*.zip
*.tar
*.gz
*.7z
*.rar

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~

# IDE files
.vscode/
.idea/
*.code-workspace

# Python specific
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ============================================================================
# DATA FILES - CSV AND DATASETS
# ============================================================================

# CSV files - ALL directories (original and preprocessed)
*.csv

# Excel files
*.xlsx
*.xls
*.xlsm

# JSON files
*.json

# Parquet files
*.parquet

# Pickle files
*.pkl
*.pickle

# ============================================================================
# CUSTOMERDNA AI PROJECT - DATASETS AND PREPROCESSED FILES
# ============================================================================

# Original datasets - ALL clients
CustomerDNA AI/datasets/

# Preprocessed data - ALL clients and ALL datasets
CustomerDNA AI/src/Preprocessing/*/cleaned_dataset/
CustomerDNA AI/src/Preprocessing/client_*/*/cleaned_dataset/

# EDA output files - ALL clients and ALL datasets  
CustomerDNA AI/src/EDA/*/output/
CustomerDNA AI/src/EDA/client_*/*/output/

# ETL output files - ALL clients
CustomerDNA AI/src/ETL/**/output/
CustomerDNA AI/src/ETL/**/processed/
CustomerDNA AI/src/ETL/**/temp/
CustomerDNA AI/src/ETL/**/cache/

# Log files - ALL directories
CustomerDNA AI/**/logs/

# Database backup files
*.dump
*.backup
*.sql

# Power BI files
*.pbix
*.pbip

# Jupyter notebook checkpoints
.ipynb_checkpoints/

# Model files
*.model
*.h5
*.keras
*.pth
*.pt

# ============================================================================
# SPECIFIC EXCLUSIONS (for backward compatibility)
# ============================================================================

# Old directory structures
/dataset
CustomerDNA AI/base_dataset/
CustomerDNA AI/project_requirements/

# Client-specific dataset directories (user requested)
CustomerDNA AI/src/Preprocessing/client_1/Customer_Personality_Analysis_dataset_Preprocessing/cleaned_dataset/
CustomerDNA AI/src/Preprocessing/client_1/E-commerce_customer_churn_Preprocessing/cleaned_dataset/
CustomerDNA AI/src/Preprocessing/client_1/Retailrocket_recommender_system_dataset_Preprocessing/cleaned_dataset/
CustomerDNA AI/src/Preprocessing/client_1/UCI_Online_Retail_2_Preprocessing/cleaned_dataset/

# Old preprocessing directories (already covered by patterns above)
CustomerDNA AI/src/Preprocessing/Customer_Personality_Analysis_dataset_Preprocessing/cleaned_dataset/
CustomerDNA AI/src/Preprocessing/E-commerce_customer_churn_Preprocessing/cleaned_dataset/
CustomerDNA AI/src/Preprocessing/Retailrocket_recommender_system_dataset_Preprocessing/cleaned_dataset/
CustomerDNA AI/src/Preprocessing/UCI_Online_Retail_2_Preprocessing/cleaned_dataset/

