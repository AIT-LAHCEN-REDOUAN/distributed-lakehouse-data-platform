TRINO_VERSION=477
TRINO_HOST_PORT=8088
TRINO_ENVIRONMENT=development
TRINO_NODE_ID=trino-coordinator
TRINO_DATA_DIR=/var/trino/data
TRINO_HTTP_PORT=8080
TRINO_QUERY_MAX_MEMORY=2GB
TRINO_QUERY_MAX_MEMORY_PER_NODE=1GB
TRINO_QUERY_MAX_TOTAL_MEMORY_PER_NODE=1GB
TRINO_JVM_HEAP=2G
TRINO_ICEBERG_CATALOG=lakehouse
TRINO_ICEBERG_CATALOG_TYPE=hive_metastore
TRINO_HIVE_METASTORE_URI=thrift://hive-metastore:9083
TRINO_ICEBERG_WAREHOUSE_URI=hdfs://namenode.customerdna.local:9000/warehouse/iceberg
TRINO_HDFS_DEFAULT_FS=hdfs://namenode.customerdna.local:9000
CUSTOMERDNA_TRINO_USER=customerdna_service
CUSTOMERDNA_TRINO_PASSWORD=change_me
