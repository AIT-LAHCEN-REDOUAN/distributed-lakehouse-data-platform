AIRFLOW_IMAGE_NAME=apache/airflow:3.2.2-python3.11
AIRFLOW_UID=50000
AIRFLOW_POSTGRES_USER=airflow
AIRFLOW_POSTGRES_PASSWORD=change_me
AIRFLOW_POSTGRES_DB=airflow

_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=change_me
_AIRFLOW_WWW_USER_FIRSTNAME=Platform
_AIRFLOW_WWW_USER_LASTNAME=Admin
_AIRFLOW_WWW_USER_EMAIL=admin@example.com

AIRFLOW__CORE__DEFAULT_TIMEZONE=Africa/Casablanca
AIRFLOW__SCHEDULER__ENABLE_HEALTH_CHECK=true
AIRFLOW__CORE__TEST_CONNECTION=Enabled
AIRFLOW__API__BASE_URL=http://localhost:8080

AIRFLOW__API_AUTH__JWT_SECRET=replace_with_long_random_secret
AIRFLOW__API_AUTH__JWT_ISSUER=airflow

CUSTOMERDNA_AIRFLOW_DW_HOST=host.docker.internal
CUSTOMERDNA_AIRFLOW_KAFKA_BOOTSTRAP_SERVERS=broker:29092
CUSTOMERDNA_AIRFLOW_HDFS_WEB_ENDPOINT=namenode:9870
CUSTOMERDNA_AIRFLOW_HDFS_NAMENODE_URI=hdfs://namenode:9000
CUSTOMERDNA_AIRFLOW_HIVE_METASTORE_HOST=hive-metastore
CUSTOMERDNA_AIRFLOW_HIVE_METASTORE_PORT=9083
CUSTOMERDNA_AIRFLOW_SPARK_MASTER_UI_URL=http://spark-master:8086
CUSTOMERDNA_AIRFLOW_DBT_SPARK_HOST=spark-thrift-server
CUSTOMERDNA_AIRFLOW_DBT_SPARK_PORT=10000
CUSTOMERDNA_AIRFLOW_TRINO_URL=http://trino:8080
CUSTOMERDNA_HDFS_BRONZE_ROOT=/bronze/client_1
CUSTOMERDNA_PROJECT_ROOT_MOUNT=../..
CUSTOMERDNA_PROJECT_ROOT_IN_CONTAINER=/opt/airflow/CustomerDNA_AI
