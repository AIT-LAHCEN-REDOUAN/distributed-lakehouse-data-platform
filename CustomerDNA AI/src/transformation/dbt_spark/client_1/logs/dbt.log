        create or replace table staging.stg_retailrocket_events
      
      
    using iceberg
      
      
      
      
      
      comment 'Typed staging view for retailrocket events.'
      

      as
      select
    to_timestamp(from_unixtime(cast(nullif(trim(timestamp), '') as bigint) / 1000)) as event_timestamp,
    cast(nullif(trim(visitorid), '') as bigint) as visitor_id,
    trim(event) as event_type,
    cast(nullif(trim(itemid), '') as bigint) as item_id,
    cast(nullif(trim(transactionid), '') as bigint) as transaction_id
from raw_data.events
  
