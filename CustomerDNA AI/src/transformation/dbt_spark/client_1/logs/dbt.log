    coalesce(
        try_cast(nullif(trim(quantity), '') as int),
        try_cast(nullif(trim(quantity), '') as double)
    ) as int
) < 0 or upper(trim(invoice)) like 'C%' then true
        else false
    end as is_return
from raw_data.online_retail_2
  
