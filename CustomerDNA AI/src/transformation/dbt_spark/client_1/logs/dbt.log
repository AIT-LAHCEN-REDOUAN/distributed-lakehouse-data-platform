, 
  
    `cashback_amount` 

  

    )
  
  comment 'Typed staging view for the ecommerce churn dataset.'
      
  as
    select
    cast(nullif(trim(customerid), '') as bigint) as customer_id,
    case
    when lower(trim(churn)) in ('1', 'true', 'yes', 'y') then true
    when lower(trim(churn)) in ('0', 'false', 'no', 'n') then false
    else null
end as is_churned,
    cast(nullif(trim(tenure), '') as int) as tenure_months,
    trim(preferredlogindevice) as preferred_login_device,
    cast(nullif(trim(citytier), '') as int) as city_tier,
    cast(nullif(trim(warehousetohome), '') as double) as warehouse_to_home_km,
    trim(preferredpaymentmode) as preferred_payment_mode,
    trim(gender) as gender,
    cast(nullif(trim(hourspendonapp), '') as double) as hours_spent_on_app,
    cast(nullif(trim(numberofdeviceregistered), '') as int) as registered_device_count,
    trim(preferedordercat) as preferred_order_category,
    cast(nullif(trim(satisfactionscore), '') as int) as satisfaction_score,
    trim(maritalstatus) as marital_status,
    cast(nullif(trim(numberofaddress), '') as int) as address_count,
    cast(nullif(trim(complain), '') as int) as complaint_flag,
    cast(nullif(trim(orderamounthikefromlastyear), '') as double) as order_amount_hike_pct,
    cast(nullif(trim(couponused), '') as int) as coupon_used_count,
    cast(nullif(trim(ordercount), '') as int) as order_count,
    cast(nullif(trim(daysincelastorder), '') as int) as days_since_last_order,
    cast(nullif(trim(cashbackamount), '') as double) as cashback_amount
from raw_data.e_commerce_customer_churn

