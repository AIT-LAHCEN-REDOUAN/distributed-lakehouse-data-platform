    cast(nullif(trim(quantity), '') as int) as quantity,
    
to_timestamp(nullif(trim(invoicedate), ''))
 as invoice_timestamp,
    cast(nullif(trim(price), '') as double) as unit_price,
    cast(nullif(trim(customer_id), '') as bigint) as customer_id,
    trim(country) as country
from raw_data.online_retail

