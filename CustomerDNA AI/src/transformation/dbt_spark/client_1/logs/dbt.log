        create or replace table staging.stg_marketing_campaign
      
      
    using iceberg
      
      
      
      
      
      comment 'Typed staging view for the customer personality and campaign dataset.'
      

      as
      select
    cast(nullif(trim(id), '') as bigint) as customer_id,
    cast(nullif(trim(year_birth), '') as int) as year_birth,
    trim(education) as education,
    trim(marital_status) as marital_status,
    cast(nullif(trim(income), '') as double) as income,
    cast(nullif(trim(kidhome), '') as int) as kidhome,
    cast(nullif(trim(teenhome), '') as int) as teenhome,
    to_date(nullif(trim(dt_customer), ''), 'd-M-yyyy') as customer_since_date,
    cast(nullif(trim(recency), '') as int) as recency_days,
    cast(nullif(trim(mntwines), '') as double) as amount_wines,
    cast(nullif(trim(mntfruits), '') as double) as amount_fruits,
    cast(nullif(trim(mntmeatproducts), '') as double) as amount_meat,
    cast(nullif(trim(mntfishproducts), '') as double) as amount_fish,
    cast(nullif(trim(mntsweetproducts), '') as double) as amount_sweets,
    cast(nullif(trim(mntgoldprods), '') as double) as amount_gold,
    cast(nullif(trim(numdealspurchases), '') as int) as deal_purchases,
    cast(nullif(trim(numwebpurchases), '') as int) as web_purchases,
    cast(nullif(trim(numcatalogpurchases), '') as int) as catalog_purchases,
    cast(nullif(trim(numstorepurchases), '') as int) as store_purchases,
    cast(nullif(trim(numwebvisitsmonth), '') as int) as monthly_web_visits,
    cast(nullif(trim(acceptedcmp1), '') as int) as accepted_campaign_1,
    cast(nullif(trim(acceptedcmp2), '') as int) as accepted_campaign_2,
    cast(nullif(trim(acceptedcmp3), '') as int) as accepted_campaign_3,
    cast(nullif(trim(acceptedcmp4), '') as int) as accepted_campaign_4,
    cast(nullif(trim(acceptedcmp5), '') as int) as accepted_campaign_5,
    cast(nullif(trim(complain), '') as int) as complaint_flag,
    cast(nullif(trim(z_costcontact), '') as double) as campaign_contact_cost,
    cast(nullif(trim(z_revenue), '') as double) as campaign_revenue,
    cast(nullif(trim(response), '') as int) as last_campaign_response_flag
from raw_data.marketing_campaign
  
