        create or replace table analytics.analytics_customer360_overview
      
      
    using iceberg
      
      
      
      
      
      comment 'Final entity-level overview for Customer 360 segmentation, conversion, and retention analysis.'
      

      as
      select
    unified_entity_id,
    entity_source,
    entity_grain,
    entity_key,
    known_customer_id,
    age,
    geography,
    acquisition_channel,
    lifecycle_stage,
    engagement_score,
    monetary_value,
    transaction_count,
    conversion_flag,
    retention_risk_flag,
    recency_days,
    feature_snapshot_date,
    case
        when monetary_value >= 10000 then 'high_value'
        when monetary_value >= 1000 then 'mid_value'
        when monetary_value > 0 then 'emerging_value'
        else 'non_monetized'
    end as value_segment,
    case
        when engagement_score >= 20 then 'high_engagement'
        when engagement_score >= 8 then 'medium_engagement'
        else 'low_engagement'
    end as engagement_segment,
    case
        when retention_risk_flag then 'at_risk'
        when conversion_flag then 'converted'
        else 'nurture'
    end as retention_segment
from intermediate.int_customer_360_feature_store
  
