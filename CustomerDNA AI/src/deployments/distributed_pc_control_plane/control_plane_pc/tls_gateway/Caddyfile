{
    auto_https disable_redirects
}

https://localhost:{$CUSTOMERDNA_CONTROL_PLANE_AIRFLOW_PORT} {
    tls internal
    log {
        output file /var/log/caddy/airflow-access.json
        format json
    }
    reverse_proxy airflow-api-server:8080
}

https://localhost:{$CUSTOMERDNA_CONTROL_PLANE_PROMETHEUS_PORT} {
    tls internal
    log {
        output file /var/log/caddy/prometheus-access.json
        format json
    }
    reverse_proxy prometheus:9090
}

https://localhost:{$CUSTOMERDNA_CONTROL_PLANE_GRAFANA_PORT} {
    tls internal
    log {
        output file /var/log/caddy/grafana-access.json
        format json
    }
    reverse_proxy grafana:3000
}

https://localhost:{$CUSTOMERDNA_CONTROL_PLANE_KAFKA_UI_PORT} {
    tls internal
    log {
        output file /var/log/caddy/kafka-ui-access.json
        format json
    }
    reverse_proxy kafka-ui:8080
}
