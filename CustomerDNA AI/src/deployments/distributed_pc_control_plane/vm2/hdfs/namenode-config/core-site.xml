<?xml version="1.0"?>
<configuration>
  <property>
    <name>fs.defaultFS</name>
    <value>hdfs://namenode.customerdna.local:9000</value>
  </property>
  <property>
    <name>hadoop.security.authentication</name>
    <value>kerberos</value>
  </property>
  <property>
    <name>hadoop.security.authorization</name>
    <value>true</value>
  </property>
  <property>
    <name>hadoop.security.auth_to_local</name>
    <value>RULE:[1:$1@$0](demo_hdfs@CUSTOMERDNA.LOCAL)s/.*/hdfs/ RULE:[2:$1/$2@$0](nn/.*@CUSTOMERDNA.LOCAL)s/.*/hdfs/ RULE:[2:$1/$2@$0](dn/.*@CUSTOMERDNA.LOCAL)s/.*/hdfs/ RULE:[2:$1/$2@$0](HTTP/.*@CUSTOMERDNA.LOCAL)s/.*/hdfs/ RULE:[2:$1/$2@$0](hive/.*@CUSTOMERDNA.LOCAL)s/.*/hive/ RULE:[2:$1/$2@$0](trino/.*@CUSTOMERDNA.LOCAL)s/.*/trino/ RULE:[2:$1/$2@$0](spark/.*@CUSTOMERDNA.LOCAL)s/.*/spark/ RULE:[1:$1@$0](.*@CUSTOMERDNA.LOCAL)s/@.*// DEFAULT</value>
  </property>
  <property>
    <name>hadoop.proxyuser.hive.hosts</name>
    <value>127.0.0.1,localhost,10.10.252.12,hive-metastore,hive-metastore.customerdna.local</value>
  </property>
  <property>
    <name>hadoop.proxyuser.hive.groups</name>
    <value>*</value>
  </property>
  <property>
    <name>hadoop.rpc.protection</name>
    <value>privacy</value>
  </property>
  <property>
    <name>hadoop.http.filter.initializers</name>
    <value>org.apache.hadoop.security.AuthenticationFilterInitializer</value>
  </property>
  <property>
    <name>hadoop.http.authentication.type</name>
    <value>kerberos</value>
  </property>
  <property>
    <name>hadoop.http.authentication.kerberos.principal</name>
    <value>HTTP/namenode.customerdna.local@CUSTOMERDNA.LOCAL</value>
  </property>
  <property>
    <name>hadoop.http.authentication.kerberos.keytab</name>
    <value>/etc/security/keytabs/nn.service.keytab</value>
  </property>
  <property>
    <name>hadoop.http.authentication.simple.anonymous.allowed</name>
    <value>false</value>
  </property>
  <property>
    <name>hadoop.http.authentication.cookie.domain</name>
    <value>.customerdna.local</value>
  </property>
</configuration>
