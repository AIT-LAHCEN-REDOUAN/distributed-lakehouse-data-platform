# Common Docker naming
CUSTOMERDNA_DOCKER_NETWORK=customerdna_kafka_shared
CUSTOMERDNA_DOCKER_PROJECT_PREFIX=customerdna

# Spark submit image lineage
CUSTOMERDNA_SPARK_SUBMIT_CLIENT_IMAGE=customerdna-spark:4.1.2-iceberg-control-plane
CUSTOMERDNA_SPARK_CLUSTER_IMAGE=customerdna-spark:4.1.2-iceberg-distributed

# Logging and metrics
CUSTOMERDNA_MONITORING_HTTP_TIMEOUT_SECONDS=15
CUSTOMERDNA_MONITORING_SOCKET_TIMEOUT_SECONDS=15
CUSTOMERDNA_MONITORING_STALE_RUNNING_RECONCILIATION_SECONDS=600

# Exporters
CUSTOMERDNA_ENABLE_CADVISOR=true
CUSTOMERDNA_ENABLE_POSTGRES_EXPORTER=true

# Runtime defaults for constrained VMs
CUSTOMERDNA_VM_RESOURCE_PROFILE=small-demo
CUSTOMERDNA_ENABLE_PRODUCTION_HARDENING=false
