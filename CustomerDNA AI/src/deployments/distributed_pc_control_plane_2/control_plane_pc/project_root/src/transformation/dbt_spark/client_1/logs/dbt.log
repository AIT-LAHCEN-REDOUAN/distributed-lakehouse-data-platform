        create or replace table intermediate.int_online_shopper_sessions
      
      
    using iceberg
      
      
      
      
      
      comment 'Session-level engagement features for digital intent analysis.'
      

      as
      select
    shopper_session_id,
    session_month,
    visitor_type,
    operating_system_id,
    browser_id,
    region_id,
    traffic_type_id,
    is_weekend_session,
